{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tanstack-start-app",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "@tanstack/react-start/server-entry",
	"vars": {
		"BETTER_AUTH_URL": "https://jovenesporlosderechoshumanoscr.org",
        "BREVO_DOI_REDIRECT_URL": "https://jovenesporlosderechoshumanoscr.org/newsletter?status=ok",
        "BREVO_DOI_TEMPLATE_ID": "1",
        "BREVO_LIST_ID": "3",
        "EMAIL_FROM": "JPDH <no-reply@jpdh.com>"
	},
	"send_email": [
		{
			"name": "EMAIL"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "jpdh-media"
		},
		{
			"binding": "PLANTILLAS",
			"bucket_name": "jpdh-plantillas"
		}
	],
	"d1_databases": [
		{
			"binding": "jpdhdb",
			"database_name": "jpdhdb",
			"database_id": "e525603f-0a8f-45bd-a33b-d8a618512328",
			"migrations_dir": "drizzle",
			"migrations_pattern": "drizzle/*/migration.sql"
		}
	]
}
